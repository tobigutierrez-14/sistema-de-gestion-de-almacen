@model CategoriaFormViewModel
@{
    var editando = Model.Id > 0;
    var titulo = editando ? "Editar categoría" : "Nueva categoría";
    ViewData["Title"] = titulo;
    ViewData["Seccion"] = "categorias";
}
<div class="page-heading product-heading">
    <div>
        <p class="eyebrow">INVENTARIO / CATEGORÍAS</p>
        <h1>@titulo<span class="title-dot">.</span></h1>
        <p class="subtitle">
            @(editando
                ? "Actualizá la información de esta categoría."
                : "Creá una categoría para clasificar tus productos.")
        </p>
    </div>
    <a class="clear-filter" asp-action="Index">← Volver al listado</a>
</div>

<form method="post"
      asp-action="@(editando ? "Editar" : "Crear")"
      asp-route-id="@(editando ? Model.Id : (int?)null)"
      class="panel product-form">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="validation-error"></div>

    <div class="form-section-title">Información de la categoría</div>
    <div class="form-grid">
        <div class="form-field full">
            <label asp-for="Nombre">Nombre *</label>
            <input asp-for="Nombre" maxlength="100" placeholder="Ej. Congelados" />
            <span asp-validation-for="Nombre"></span>
        </div>
        <div class="form-field full">
            <label asp-for="Descripcion">Descripción</label>
            <textarea asp-for="Descripcion"
                      maxlength="400"
                      rows="4"
                      placeholder="¿Qué productos agrupa esta categoría?"></textarea>
            <span asp-validation-for="Descripcion"></span>
        </div>
    </div>

    <p class="form-hint">Los cambios de nombre se reflejan automáticamente en los productos asociados.</p>

    <div class="form-actions">
        <a class="action-secondary" asp-action="Index">Cancelar</a>
        <button class="action-primary" type="submit">
            @(editando ? "Guardar cambios" : "Registrar categoría")
        </button>
    </div>
</form>
